{
  "service": {
    "name": "hotel-service",
		"port": 8082,
		"check": {
      "http": "http://localhost:8080/health",
      "interval": "10s",
      "timeout": "1s"
    },
    "connect": {
      "sidecar_service": {
        "proxy": {
          "upstreams": [
            {
              "destination_name": "postgres",
              "local_bind_port": 5432
            }
          ]
        }
      }
    }
  }
}

